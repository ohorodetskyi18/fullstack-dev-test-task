# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required ---
# Tailscale auth key: Settings → Keys → Generate auth key. Single-use, pre-approved, tag: tag:ghost.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Your tailnet's MagicDNS suffix (DNS page of the admin console, or: tailscale status --json | jq -r .MagicDNSSuffix)
TS_TAILNET_DNS=tailxxxxxx.ts.net
# Hetzner Cloud API token (Read & Write). Not needed for ./deploy.sh --local.
HCLOUD_TOKEN=

# --- Optional (defaults shown) ---
# SERVER_NAME=ghost-blog          # Hetzner server name and tailnet hostname → https://ghost-blog.<tailnet>.ts.net
# SERVER_TYPE=cax11               # Hetzner type; cax11 = 2 ARM vCPU / 4 GB RAM. List: hcloud server-type list
# LOCATION=fsn1                   # Hetzner location. List: hcloud location list
# GHOST_ADMIN_EMAIL=admin@example.com
# GHOST_ADMIN_PASSWORD=           # generated if empty; saved to .ghost-admin-credentials
# GHOST_BLOG_TITLE=Ghost on Hetzner
